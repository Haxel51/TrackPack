rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for auth & role verification
    function isSignedIn() {
      return request.auth != null;
    }

    // Sessions and internal auth
    match /sessions/{sessionId} {
      allow read, write: if true;
    }

    // Fleet Tracking Trips
    match /fleetTracking_trips/{tripId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false; // Deletion of trips is forbidden
    }

    // Fleet Tracking Trucks
    match /fleetTracking_trucks/{truckId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Fleet Tracking Suppliers
    match /fleetTracking_suppliers/{supplierId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Fleet Tracking Garages
    match /fleetTracking_garages/{garageId} {
      allow read, write: if true;
    }

    // Fleet Tracking Users & Team Members
    match /fleetTracking_users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Managers collection
    match /managers/{managerId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Fallback collection rules
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

