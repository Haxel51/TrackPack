{
  "entities": {
    "FleetGarage": {
      "title": "FleetGarage",
      "description": "Company garage origin location for fleet operations",
      "type": "object",
      "properties": {
        "address_text": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "location_confirmed": { "type": "boolean" },
        "confirmed_by": { "type": "string" },
        "confirmed_at": { "type": "string" },
        "company_id": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["address_text", "location_confirmed", "company_id"]
    },
    "FleetSupplier": {
      "title": "FleetSupplier",
      "description": "Supplier or company destination location for fleet operations",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "address_text": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "location_confirmed": { "type": "boolean" },
        "confirmed_by": { "type": "string" },
        "confirmed_at": { "type": "string" },
        "company_id": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["name", "address_text", "location_confirmed", "company_id"]
    },
    "FleetTruck": {
      "title": "FleetTruck",
      "description": "Truck profile with driver details and payment plan settings",
      "type": "object",
      "properties": {
        "plate_number": { "type": "string" },
        "driver_name": { "type": "string" },
        "driver_phone": { "type": "string" },
        "payment_plan": { "type": "string", "enum": ["per_trip", "monthly"] },
        "subscription_active_until": { "type": "string" },
        "created_at": { "type": "string" },
        "created_by": { "type": "string" },
        "company_id": { "type": "string" }
      },
      "required": ["plate_number", "driver_name", "driver_phone", "payment_plan", "company_id"]
    },
    "FleetTrip": {
      "title": "FleetTrip",
      "description": "Fleet tracking haulage trip record",
      "type": "object",
      "properties": {
        "truck_id": { "type": "string" },
        "plate_number": { "type": "string" },
        "driver_name": { "type": "string" },
        "driver_phone": { "type": "string" },
        "primary_destination_type": { "type": "string" },
        "primary_destination_id": { "type": "string" },
        "primary_destination_name": { "type": "string" },
        "primary_destination_lat": { "type": "number" },
        "primary_destination_lng": { "type": "number" },
        "redirect_destination": { "type": ["object", "null"] },
        "payment_plan": { "type": "string" },
        "payment_status": { "type": "string" },
        "payment_amount": { "type": "number" },
        "trip_status": { "type": "string" },
        "status_history": { "type": "array" },
        "last_known_lat": { "type": ["number", "null"] },
        "last_known_lng": { "type": ["number", "null"] },
        "last_movement_at": { "type": ["string", "null"] },
        "stopped_warning_sent": { "type": "boolean" },
        "stopped_alert_sent": { "type": "boolean" },
        "created_by": { "type": "string" },
        "created_at": { "type": "string" },
        "garage_lat": { "type": "number" },
        "garage_lng": { "type": "number" },
        "company_id": { "type": "string" }
      },
      "required": ["truck_id", "plate_number", "primary_destination_id", "payment_plan", "company_id"]
    },
    "FleetCustomer": {
      "title": "FleetCustomer",
      "description": "Saved customer redirect destination locations",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "address_text": { "type": "string" },
        "lat": { "type": ["number", "null"] },
        "lng": { "type": ["number", "null"] },
        "created_at": { "type": "string" },
        "created_by": { "type": "string" },
        "company_id": { "type": "string" }
      },
      "required": ["name", "address_text", "company_id"]
    },
    "DeveloperAccount": {
      "title": "DeveloperAccount",
      "description": "Registered developer profile with isolated sandbox credentials and locked production status",
      "type": "object",
      "properties": {
        "merchant_name": { "type": "string" },
        "contact_email": { "type": "string" },
        "contact_phone": { "type": "string" },
        "test_key": { "type": "string" },
        "test_key_hash": { "type": "string" },
        "sandbox_balance": { "type": "number" },
        "live_status": { "type": "string", "enum": ["locked", "pending_verification", "approved", "rejected"] },
        "live_key": { "type": ["string", "null"] },
        "live_key_masked": { "type": ["string", "null"] },
        "live_key_hash": { "type": ["string", "null"] },
        "cargo_wallet_balance": { "type": "number" },
        "cargo_wallet_status": { "type": "string", "enum": ["active", "low_balance", "depleted", "inactive"] },
        "virtual_account_bank": { "type": "string" },
        "virtual_account_number": { "type": "string" },
        "virtual_account_name": { "type": "string" },
        "total_manifests_billed": { "type": "number" },
        "total_cargo_wallet_spent": { "type": "number" },
        "auto_topup_threshold": { "type": "number" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["merchant_name", "contact_email", "test_key", "live_status"]
    },
    "DeveloperWalletTransaction": {
      "title": "DeveloperWalletTransaction",
      "description": "Immutable ledger entry for developer cargo wallet credits (top-ups) and automated per-waybill manifest debits (Step C)",
      "type": "object",
      "properties": {
        "developer_id": { "type": "string" },
        "type": { "type": "string", "enum": ["credit", "debit", "refund"] },
        "amount": { "type": "number" },
        "balance_before": { "type": "number" },
        "balance_after": { "type": "number" },
        "currency": { "type": "string" },
        "reference": { "type": "string" },
        "channel": { "type": "string" },
        "description": { "type": "string" },
        "waybill_id": { "type": ["string", "null"] },
        "tracking_code": { "type": ["string", "null"] },
        "created_at": { "type": "string" }
      },
      "required": ["developer_id", "type", "amount", "balance_before", "balance_after", "reference", "created_at"]
    },
    "DeveloperCompliance": {
      "title": "DeveloperCompliance",
      "description": "Business KYC & compliance submission record for production live key access (Step B)",
      "type": "object",
      "properties": {
        "developer_id": { "type": "string" },
        "business_legal_name": { "type": "string" },
        "cac_rc_number": { "type": "string" },
        "cac_registration_type": { "type": "string", "enum": ["RC", "BN", "IT"] },
        "cac_document_name": { "type": "string" },
        "cac_document_data": { "type": "string" },
        "tin": { "type": "string" },
        "director_name": { "type": "string" },
        "director_role": { "type": "string" },
        "director_id_type": { "type": "string", "enum": ["NIN", "DRIVERS_LICENSE", "INTERNATIONAL_PASSPORT", "VOTERS_CARD"] },
        "director_id_number": { "type": "string" },
        "director_id_document_name": { "type": "string" },
        "director_id_document_data": { "type": "string" },
        "street_address": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "lga": { "type": "string" },
        "warehouse_location": { "type": "string" },
        "store_website_url": { "type": "string" },
        "monthly_parcel_volume": { "type": "string" },
        "status": { "type": "string", "enum": ["under_review", "approved", "action_required"] },
        "rejection_reason": { "type": ["string", "null"] },
        "submitted_at": { "type": "string" },
        "reviewed_at": { "type": ["string", "null"] },
        "reviewed_by": { "type": ["string", "null"] }
      },
      "required": ["developer_id", "business_legal_name", "cac_rc_number", "director_name", "director_id_number", "street_address", "state", "status", "submitted_at"]
    }
  },
  "firestore": {
    "/fleetTracking_garages/{garageId}": {
      "schema": { "$ref": "#/entities/FleetGarage" },
      "description": "Garage location configuration documents"
    },
    "/fleetTracking_suppliers/{supplierId}": {
      "schema": { "$ref": "#/entities/FleetSupplier" },
      "description": "Registered destination and supplier locations"
    },
    "/fleetTracking_trucks/{truckId}": {
      "schema": { "$ref": "#/entities/FleetTruck" },
      "description": "Truck profiles with payment plans"
    },
    "/fleetTracking_trips/{tripId}": {
      "schema": { "$ref": "#/entities/FleetTrip" },
      "description": "Fleet trip dispatches and redirect destinations"
    },
    "/fleetTracking_customers/{customerId}": {
      "schema": { "$ref": "#/entities/FleetCustomer" },
      "description": "Saved customer redirect destinations"
    },
    "/developer_accounts/{developerId}": {
      "schema": { "$ref": "#/entities/DeveloperAccount" },
      "description": "Developer merchant credentials, sandbox test keys, and live key approval states"
    },
    "/developer_compliance/{complianceId}": {
      "schema": { "$ref": "#/entities/DeveloperCompliance" },
      "description": "Business KYC documentation, CAC verification records, and physical warehouse reviews"
    },
    "/developer_wallet_transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/DeveloperWalletTransaction" },
      "description": "Ledger entries for developer cargo wallet top-ups and live manifest fee deductions"
    }
  }
}
