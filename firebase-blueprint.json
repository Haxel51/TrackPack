{
  "project_name": "TrackWay",
  "collections": [
    {
      "name": "companies",
      "description": "Transport companies that own parks",
      "fields": [
        { "name": "name", "type": "string", "description": "Company name" },
        { "name": "parks", "type": "array", "description": "List of park locations" },
        { "name": "ownerPhone", "type": "string", "description": "Owner's phone number" }
      ]
    },
    {
      "name": "staff",
      "description": "Staff members working at parks",
      "fields": [
        { "name": "name", "type": "string", "description": "Staff name" },
        { "name": "park", "type": "string", "description": "Assigned park" },
        { "name": "pin", "type": "string", "description": "4-digit PIN for login" },
        { "name": "companyId", "type": "string", "description": "Reference to company" },
        { "name": "role", "type": "string", "description": "Staff role, e.g., sender, receiver, etc." }
      ]
    },
    {
      "name": "waybills",
      "description": "Tracking waybills for packages",
      "fields": [
        { "name": "trackingCode", "type": "string", "description": "Auto-generated tracking code e.g. TRK-4821" },
        { "name": "senderName", "type": "string", "description": "Sender name" },
        { "name": "senderPhone", "type": "string", "description": "Sender phone number" },
        { "name": "receiverName", "type": "string", "description": "Receiver name" },
        { "name": "receiverPhone", "type": "string", "description": "Receiver phone number" },
        { "name": "itemDescription", "type": "string", "description": "Description of item" },
        { "name": "busNumber", "type": "string", "description": "Bus or vehicle number" },
        { "name": "originPark", "type": "string", "description": "Origin park name" },
        { "name": "destinationPark", "type": "string", "description": "Destination park name" },
        { "name": "status", "type": "string", "description": "Status: Booked | Departed | In Transit | Arrived | Collected" },
        { "name": "createdTimestamp", "type": "number", "description": "Created at" },
        { "name": "departedTimestamp", "type": "number", "description": "Departed at" },
        { "name": "arrivedTimestamp", "type": "number", "description": "Arrived at" },
        { "name": "collectedTimestamp", "type": "number", "description": "Collected at" },
        { "name": "pickupCode", "type": "string", "description": "4-digit code to collect" }
      ]
    },
    {
      "name": "platform_admin",
      "description": "Platform-wide administrator credentials and session settings",
      "fields": [
        { "name": "email", "type": "string", "description": "Admin email address" },
        { "name": "passwordHash", "type": "string", "description": "SHA-256 password hash" },
        { "name": "revocationId", "type": "string", "description": "Random string used to invalidate sessions across devices" },
        { "name": "temp2FACode", "type": "string", "description": "Temporary 6-digit verification code" },
        { "name": "temp2FAExpires", "type": "number", "description": "Expiration timestamp for the 2FA code" }
      ]
    }
  ],
  "security_rules": {
    "approach": "prototype",
    "description": "Allow all authenticated users to read and write for rapid prototyping, with dedicated rules for platform_admin/credentials."
  }
}
